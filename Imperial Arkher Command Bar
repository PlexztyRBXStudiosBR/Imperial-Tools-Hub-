-- ============================================
-- FUNÇÕES UTILITÁRIAS
-- ============================================
local function createInstance(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    inst.Parent = parent
    return inst
end

local function createButton(text, props, parent, callback)
    local btn = createInstance("TextButton", {
        Text = text,
        Font = CONFIG.FONT,
        TextSize = CONFIG.FONT_SIZE,
        TextColor3 = CONFIG.THEME.Text,
        BackgroundColor3 = CONFIG.THEME.ButtonBg,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, parent)
    
    for k, v in pairs(props) do
        btn[k] = v
    end
    
    local corner = createInstance("UICorner", {
        CornerRadius = UDim.new(0, CONFIG.CORNER_RADIUS),
    }, btn)
    
    btn.MouseButton1Click:Connect(callback)
    
    -- Efeito hover
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = CONFIG.THEME.ButtonHover
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = CONFIG.THEME.ButtonBg
    end)
    
    return btn
end

-- ============================================
-- FORMATAÇÃO DE TEXTO (resolve problema de linha única)
-- ============================================
local function formatPastedText(text)
    -- Detecta se o texto veio em uma linha só com padrões de código Luau
    if not text:find("\n") and text:len() > 50 then
        -- Tenta detectar padrões comuns de código Luau e adicionar quebras
        local formatted = text
        
        -- Adiciona quebra após 'end', 'then', 'do', 'else', 'elseif'
        formatted = formatted:gsub("(%f[%w]end%f[%W])", "%1\n")
        formatted = formatted:gsub("(%f[%w]then%f[%W])", "%1\n")
        formatted = formatted:gsub("(%f[%w]do%f[%W])", "%1\n")
        formatted = formatted:gsub("(%f[%w]else%f[%W])", "%1\n")
        formatted = formatted:gsub("(%f[%w]elseif%f[%W])", "%1\n")
        
        -- Adiciona quebra após '{' e antes de '}'
        formatted = formatted:gsub("{", "{\n")
        formatted = formatted:gsub("}", "\n}")
        
        -- Adiciona quebra após ',' em listas longas
        formatted = formatted:gsub(",%s*(%w)", ",\n%1")
        
        -- Adiciona quebra após 'local' no início de declarações
        formatted = formatted:gsub("(%f[%w]local%s+%w+%s*=%s*)", "\n%1")
        formatted = formatted:gsub("(%f[%w]local%s+function%s)", "\n%1")
        
        -- Adiciona quebra após 'function'
        formatted = formatted:gsub("(%f[%w]function%s*%b())", "%1\n")
        
        -- Adiciona quebra após ')' no final de chamadas
        formatted = formatted:gsub(")%s*([%w_])", ")\n%1")
        
        -- Indentação básica
        local indent = 0
        local lines = {}
        for line in formatted:gmatch("[^\n]+") do
            line = line:match("^%s*(.-)%s*$") -- trim
            if line == "" then continue end
            
            -- Reduz indentação para end/else/elseif/}
            if line:match("^end%f[%W]") or line:match("^else%f[%W]") or 
               line:match("^elseif%f[%W]") or line:match("^}") then
                indent = math.max(0, indent - 1)
            end
            
            lines[#lines + 1] = string.rep("    ", indent) .. line
            
            -- Aumenta indentação para then/do/{/function
            if line:match("then%f[%W]") or line:match("do%f[%W]") or 
               line:match("{%s*$") or line:match("function%s*%b()$") or
               line:match("function%s*%w+$") then
                indent = indent + 1
            end
        end
        
        return table.concat(lines, "\n")
    end
    
    return text
end

