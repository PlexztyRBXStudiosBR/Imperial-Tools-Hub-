-- ============================================
-- DETECÇÃO DE COLAGEM (Ctrl+V do teclado personalizado)
-- ============================================
local lastText = ""
local pasteDebounce = false

codeInput:GetPropertyChangedSignal("Text"):Connect(function()
    if pasteDebounce then return end
    
    local newText = codeInput.Text
    
    -- Detecta colagem em massa (texto muito longo adicionado de uma vez)
    if #newText > #lastText + 100 and not newText:find("\n") and newText:len() > 200 then
        pasteDebounce = true
        
        addOutput("📋 Texto colado detectado (linha única). Formatando...", CONFIG.THEME.Warning)
        
        task.delay(0.3, function()
            local formatted = formatPastedText(newText)
            codeInput.Text = formatted
            addOutput("✓ Texto formatado automaticamente!", CONFIG.THEME.Success)
            pasteDebounce = false
        end)
    end
    
    lastText = newText
end)

-- ============================================
-- ATALHOS DE TECLADO (Ctrl+V, Ctrl+C, Ctrl+Enter)
-- ============================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    
    if input.KeyCode == Enum.KeyCode.V and input.UserInputType == Enum.UserInputType.Keyboard then
        -- Ctrl+V detectado - aguarda o texto ser colado
        task.delay(0.2, function()
            local text = codeInput.Text
            if text and text:len() > 100 and not text:find("\n") then
                addOutput("📋 Ctrl+V detectado. Formatando...", CONFIG.THEME.Warning)
                codeInput.Text = formatPastedText(text)
            end
        end)
    end
    
    if input.KeyCode == Enum.KeyCode.Return and input.UserInputType == Enum.UserInputType.Keyboard then
        -- Ctrl+Enter para executar
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            runBtn:Fire()
        end
    end
end)

-- ============================================
-- DRAG PARA MOVER A GUI
-- ============================================
local dragging = false
local dragStart = nil
local startPos = nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

